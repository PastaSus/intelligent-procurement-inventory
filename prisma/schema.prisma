generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password_hash String
  role          Role     @default(STAFF)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  created_by    String?
  updated_by    String?
  deleted       Boolean  @default(false)
  reset_tokens  PasswordResetToken[]

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  user_id   String
  token     String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token])
}

model LaboratoryRoom {
  id        String        @id @default(cuid())
  name      String        @unique
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  created_by String?
  updated_by String?
  deleted    Boolean      @default(false)
  units      ComputerUnit[]

  @@index([name])
  @@index([deleted])
}

model ComputerUnit {
  id               String             @id @default(cuid())
  unit_name        String
  laboratory_room_id String
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  created_by       String?
  updated_by       String?
  deleted          Boolean            @default(false)
  laboratory_room  LaboratoryRoom     @relation(fields: [laboratory_room_id], references: [id])
  components       ComputerComponent[]
  installedApplications InstalledApplication[]

  @@unique([unit_name, laboratory_room_id])
  @@index([laboratory_room_id])
  @@index([deleted])
}

model ComputerComponent {
  id               String           @id @default(cuid())
  computer_unit_id String
  type             ComponentType
  serial_number    String           @unique
  specifications   String
  status           ComponentStatus  @default(FUNCTIONAL)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  created_by       String?
  updated_by       String?
  computer_unit    ComputerUnit     @relation(fields: [computer_unit_id], references: [id], onDelete: Cascade)

  @@index([computer_unit_id])
  @@index([type])
  @@index([status])
}

model InstalledApplication {
  id               String        @id @default(cuid())
  computer_unit_id String
  name             String
  version          String?
  license_key      String?
  license_type     LicenseType   @default(NONE)
  install_date     DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  computer_unit    ComputerUnit  @relation(fields: [computer_unit_id], references: [id], onDelete: Cascade)

  @@index([computer_unit_id])
  @@index([name])
}

model InventoryItem {
  id            String        @id @default(cuid())
  sku           String        @unique
  name          String
  description   String?
  quantity      Int           @default(0)
  reorder_point Int           @default(0)
  component_type ComponentType?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  created_by    String?
  updated_by    String?
  deleted       Boolean       @default(false)

  @@index([sku])
  @@index([component_type])
  @@index([deleted])
}

model PurchaseRequest {
  id         String               @id @default(cuid())
  pr_number  String               @unique
  status     PurchaseRequestStatus @default(DRAFT)
  notes      String?
  created_at DateTime             @default(now())
  updated_at DateTime             @updatedAt
  created_by String?
  updated_by String?
  deleted    Boolean              @default(false)
  items      RequestItem[]

  @@index([status])
  @@index([deleted])
  @@index([created_at])
}

model RequestItem {
  id                  String          @id @default(cuid())
  purchase_request_id String
  item_name           String
  quantity            Int
  unit_price          Decimal?        @db.Decimal(10, 2)
  total               Decimal?        @db.Decimal(10, 2)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  purchase_request    PurchaseRequest @relation(fields: [purchase_request_id], references: [id], onDelete: Cascade)

  @@index([purchase_request_id])
}

enum Role {
  ADMIN
  STAFF
}

enum ComponentType {
  MOTHERBOARD
  PROCESSOR
  MEMORY
  HDD
  MONITOR
  KEYBOARD
  MOUSE
  AVR
  OPTICAL_DRIVE
}

enum ComponentStatus {
  FUNCTIONAL
  NEEDS_REPAIR
  NEEDS_REPLACEMENT
}

enum LicenseType {
  NONE
  FREE
  COMMERCIAL
  OPEN_SOURCE
  EDUCATIONAL
}

enum PurchaseRequestStatus {
  DRAFT
  REQUESTED
  APPROVED
  REJECTED
  FULFILLED
}
